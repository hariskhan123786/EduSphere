{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permission set for EduSphere AI desktop. Grants the minimum capabilities required for the school-management UI to function. Network access is limited to Supabase and the local sync server.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:webview:default",
    "core:path:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "fs:allow-resource-read-recursive",
    "fs:allow-download-write",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "shell:allow-open",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    "notification:allow-notify"
  ]
}
